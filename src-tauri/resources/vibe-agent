#!/usr/bin/env python3
"""Authenticated CLI for Vibe Studio's per-user agent control socket."""

import argparse
import json
import os
import plistlib
import socket
import sys
from pathlib import Path


def control_dir() -> Path:
    override = os.environ.get("VIBE_STUDIO_CONTROL_DIR")
    if override:
        return Path(override)
    if sys.platform == "darwin":
        identifier = "dev.kevinduong.vibe-studio"
        for parent in Path(__file__).resolve().parents:
            info = parent / "Info.plist"
            if info.is_file():
                try:
                    with info.open("rb") as handle:
                        identifier = plistlib.load(handle).get("CFBundleIdentifier", identifier)
                except (OSError, plistlib.InvalidFileException):
                    pass
                break
        return Path.home() / f"Library/Application Support/{identifier}"
    return Path(os.environ.get("XDG_DATA_HOME", Path.home() / ".local/share")) / "dev.kevinduong.vibe-studio"


def parser() -> argparse.ArgumentParser:
    root = argparse.ArgumentParser(prog="vibe-agent")
    root.add_argument("--socket", dest="socket_path")
    root.add_argument("--token-file")
    root.add_argument("--token", help="Use a short-lived project capability instead of the global token file")
    commands = root.add_subparsers(dest="command", required=True)
    commands.add_parser("list")
    events = commands.add_parser("events")
    events.add_argument("--after-seq", type=int, default=0)
    events.add_argument("--timeout-ms", type=int, default=30000)
    focus = commands.add_parser("focus")
    focus.add_argument("terminal_id")
    focus.add_argument("--timeout-ms", type=int, default=30000)
    prompt = commands.add_parser("prompt")
    prompt.add_argument("terminal_id")
    prompt.add_argument("text")
    prompt.add_argument("--generation", type=int)
    prompt.add_argument("--mode", choices=("queue", "steer"), default="queue")
    prompt.add_argument("--wait", action="store_true")
    prompt.add_argument("--timeout-ms", type=int, default=30000)
    wait = commands.add_parser("wait")
    wait.add_argument("terminal_id")
    wait.add_argument("desired", nargs="*", default=["idle", "blocked"])
    wait.add_argument("--generation", type=int)
    wait.add_argument("--request-id")
    wait.add_argument("--timeout-ms", type=int, default=30000)
    start = commands.add_parser("start")
    start.add_argument("workspace_path")
    start.add_argument("text", nargs="?")
    start.add_argument("--kind", choices=("claude", "codex"), default="codex")
    start.add_argument("--name")
    start.add_argument("--shared", action="store_true", help="Run in the existing checkout instead of an isolated worktree")
    start.add_argument("--timeout-ms", type=int, default=120000)
    capability = commands.add_parser("capability")
    capability.add_argument("workspace_path")
    capability.add_argument("--ttl-seconds", type=int, default=900)
    cancel = commands.add_parser("cancel")
    cancel.add_argument("request_id")
    return root


def request_for(args: argparse.Namespace) -> dict:
    req = {"command": args.command}
    for name in (
        "terminal_id", "generation", "text", "mode", "workspace_path", "timeout_ms",
        "after_seq", "request_id", "ttl_seconds", "kind",
    ):
        if hasattr(args, name) and getattr(args, name) is not None:
            req["".join([name.split("_")[0], *[part.title() for part in name.split("_")[1:]]])] = getattr(args, name)
    if args.command == "prompt":
        req["wait"] = args.wait
    elif args.command == "wait":
        req["desired"] = args.desired
    elif args.command == "start":
        req["taskName"] = args.name
        req["isolated"] = not args.shared
    return req


def main() -> int:
    args = parser().parse_args()
    directory = control_dir()
    socket_path = Path(args.socket_path) if args.socket_path else directory / "agent-control.sock"
    token_file = Path(args.token_file) if args.token_file else directory / "agent-control.token"
    token = args.token or os.environ.get("VIBE_STUDIO_CAPABILITY")
    if not token:
        token = token_file.read_text(encoding="utf-8").strip()
    request = request_for(args)
    request["token"] = token
    encoded = (json.dumps(request, separators=(",", ":")) + "\n").encode()
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as client:
        client.connect(str(socket_path))
        client.sendall(encoded)
        response = b""
        while not response.endswith(b"\n"):
            chunk = client.recv(65536)
            if not chunk:
                break
            response += chunk
    payload = json.loads(response)
    if not payload.get("ok"):
        print(payload.get("error", "request failed"), file=sys.stderr)
        return 1
    print(json.dumps(payload.get("result"), indent=2, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
